# SQLite database file (default: package data dir / rootrecord.db)
# SQLITE_PATH=C:\path\to\rootrecord.db

# --- License API (Cloudflare Worker; optional until you wire the desktop app) ---
# Base URL only, no trailing slash (e.g. https://rootrecord-license.your-subdomain.workers.dev)
# LICENSE_API_BASE_URL=
# Same value as GitHub secret LICENSE_API_SECRET / wrangler secret LICENSE_API_SECRET (Bearer token)
# LICENSE_API_SECRET=
