# SQLite database file (default: package data dir / rootrecord.db)
# SQLITE_PATH=C:\path\to\rootrecord.db

# --- Firebase (optional: account sign-in + encrypted cloud backup in Settings) ---
# See firebase/FIREBASE_SETUP.md. Project settings (gear) → General: Project ID + Web API key.
# FIREBASE_WEB_API_KEY=your_web_api_key_here
# FIREBASE_PROJECT_ID=your-project-id
# Bucket name only (check Storage → Files). Examples:
#   your-project-id.appspot.com
#   your-project-id.firebasestorage.app
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
