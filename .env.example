# SQLite database file (default: package data dir / rootrecord.db)
# SQLITE_PATH=C:\path\to\rootrecord.db

# --- License API (Cloudflare Worker). Omit LICENSE_API_BASE_URL to disable remote checks (local dev). ---
# Base URL only, no trailing slash (e.g. https://rootrecord-license.your-subdomain.workers.dev)
# LICENSE_API_BASE_URL=
# Bearer token (same as wrangler secret / GitHub LICENSE_API_SECRET)
# LICENSE_API_SECRET=
# Email for trial/subscription (optional if you enter it once at startup; stored as license_account_email)
# LICENSE_EMAIL=
