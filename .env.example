# SQLite database file (default: package data dir / rootrecord.db)
# SQLITE_PATH=C:\path\to\rootrecord.db

# --- License API (remote HTTPS service). Omit LICENSE_API_BASE_URL to disable remote checks (local dev). ---
# Installed (PyInstaller) builds use license_shipped.SHIPPED_LICENSE_API_BASE_URL when this is unset.
# Base URL only — no trailing slash. Do not append /v1 (client paths already start with /v1/...).
# Example: https://license.example.com
# LICENSE_API_BASE_URL=
# Frozen builds: default strict sign-in (no cache bypass). Set LICENSE_STRICT_AUTH=0 to relax.
# Internal frozen testing with shared secret: LICENSE_SHIPPED_ALLOW_API_SECRET=1
# Bearer token (same as LICENSE_API_SECRET on the license server). When set, the app uses it for /v1/entitlement when
# you have no session yet (no extra flag required).
# LICENSE_API_SECRET=
# Shipped SaaS builds: omit LICENSE_API_SECRET and set this so the client never sends the shared secret:
# LICENSE_FORCE_SIGNIN_ONLY=1
#
# Dev: skip the sign-in window and use LICENSE_API_SECRET + email first (old behavior):
# LICENSE_LEGACY_LICENSE_FIRST=1
# Email for trial/subscription (optional if you enter it once at startup; stored as license_account_email)
# LICENSE_EMAIL=
# Account UUID from the license server is stored as license_cloud_account_id after a successful check (do not set manually).

# Optional: override default Stripe Payment Link URL (see license_config.DEFAULT_STRIPE_PAYMENT_LINK)
# LICENSE_PAYMENT_LINK_URL=

# --- Optional: isolated cloud copy of local SQLite backups (dedicated Worker + R2; see cloudflare/backup-worker/) ---
# Highest-priority override for the backup Worker origin (no trailing /v1 on the value).
# ROOTRECORD_BACKUP_API_BASE_URL=https://rootrecord-desktop-backup.your-subdomain.workers.dev
# Shipped builds: set backup_shipped.SHIPPED_BACKUP_API_BASE_URL (same URL) so users do not need env vars.
